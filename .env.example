# Copy to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=
PUBLIC_URL=http://localhost:5000
CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Meta WhatsApp Cloud API (needs a verified business)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
RAVI_WHATSAPP=
GRAPH_VERSION=v23.0
# Gnani voice agent (optional) - your own whitelisted test number(s), comma separated
GNANI_MODE=
GNANI_WHITELIST=
GNANI_CONVERSATION_IDS=
GNANI_CALL_DURATIONS=
GNANI_PAYOUT=
PINELABS_MODE=
DELHIVERY_MODE=
DELIVERY_STEP_SECONDS=
DOC_UPLOAD_SETTLE_SECONDS=
MAX_AGENT_STEPS=
DEV=
